{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Environment request",
  "type": "object",
  "required": [
    "environment_name",
    "module_source",
    "module_version",
    "region",
    "ttl_hours",
    "owner",
    "cost_center",
    "purpose",
    "requested_by",
    "approvers",
    "created_date",
    "tags"
  ],
  "properties": {
    "environment_name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,30}$"},
    "module_source": {"type": "string"},
    "module_version": {"type": "string"},
    "region": {"type": "string"},
    "ttl_hours": {"type": "integer", "minimum": 1},
    "owner": {"type": "string", "format": "email"},
    "cost_center": {"type": "string", "pattern": "^CC-[0-9]{4}$"},
    "purpose": {"type": "string", "minLength": 1},
    "requested_by": {"type": "string"},
    "approvers": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "created_date": {"type": "string", "format": "date"},
    "tags": {"type": "object"}
  },
  "additionalProperties": false
}
